{
  "name": "aura-math",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests index.html package.json tsconfig.json",
    "format:check": "prettier --check src tests index.html package.json tsconfig.json",
    "lint": "eslint src tests",
    "test:e2e": "playwright test",
    "content:validate": "node scripts/content.mjs validate",
    "content:generate": "node scripts/content.mjs generate",
    "content:release": "node scripts/build-learner.mjs --check",
    "build:learner": "tsc --noEmit && node scripts/build-learner.mjs",
    "test:release": "npm run build:learner && node scripts/check-learner-artifact.mjs",
    "content:review": "node scripts/review-candidate.mjs",
    "content:examples": "node scripts/content-examples.mjs",
    "content:publish-unreviewed": "node scripts/publish-unreviewed.mjs --level P4",
    "deploy:home": "node scripts/publish-unreviewed.mjs --level P4 --check && npm run test:release"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/three": "0.162.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "5.8.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "ws": "8.22.0"
  },
  "dependencies": {
    "three": "0.162.0"
  }
}
