        "answer": "8",
        "hints": [
          "Find the used part first.",
          "Divide 32 into 4 equal parts.",
          "3 parts have 24 stickers.",
          "32 − 24 = 8 stickers remain."
        ]
      },
      {
        "id": "reflection",
        "goal": "reflection",
        "title": "Explain the equal parts",
        "prompt": "What makes the fraction calculation fair?",
        "kind": "choice",
        "choices": [
          {
            "id": "r8",
            "label": "Parts can be counted together even if the wholes differ."
          },
          {
            "id": "r3",
            "label": "The wholes match and each part has the same size."
          },
          {
            "id": "r6",
            "label": "The denominator tells us how many objects are left."
          }
        ],
        "answer": "r3",
        "hints": [
          "Look at the whole first.",
          "Equal fractions need equal-size wholes.",
          "Count parts that have the same size.",
          "Choose: The wholes match and each part has the same size."
        ]
