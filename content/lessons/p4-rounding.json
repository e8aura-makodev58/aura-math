    "title": "Round on the number line",
    "subtitle": "P4 whole-number revision",
    "level": "P4 candidate",
    "minutes": 7,
    "objective": "Round a whole number to the nearest 10, 100 or 1 000.",
    "story": "Find where 4 637 sits on the number line.",
    "reviewStatus": "draft",
    "specification": {
      "task": "rounding",
