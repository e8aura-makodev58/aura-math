{
  "name": "aura-math-fire-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Aura Math for Amazon Fire TV (Vega OS) \u2014 shared-screen math practice driven by the Fire TV remote.",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "bundle": "node scripts/build-bundle.js",
    "hermes": "node scripts/compile-hermes.js",
    "sync-lessons": "node scripts/build-lesson-index.js",
    "build": "npm run bundle && npm run hermes",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.1",
    "@types/react-test-renderer": "19.1.0",
    "@types/three": "^0.162.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "29.7.0",
    "react-test-renderer": "19.2.0",
    "three": "^0.162.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.67.0",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0"
  },
  "jest": {
    "preset": "react-native",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@amazon-devices)/)"
    ]
  },
  "kepler": {
    "projectType": "application",
    "appName": "AuraMath",
    "targets": [
      "tv"
    ]
  }
}
